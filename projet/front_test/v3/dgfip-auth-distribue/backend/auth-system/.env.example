PORT=5001
INTERNAL_SHARED_SECRET=change-moi-en-production
LOG_COLLECTOR_URL=http://localhost:5002

# Annuaire LDAP : "mock" (par défaut, aucune dépendance externe) ou "real"
LDAP_MODE=mock
LDAP_BASE_DN=dc=dgfip,dc=local
LDAP_BIND_DN=cn=auth-system,dc=dgfip,dc=local
LDAP_BIND_PASSWORD=service-account-password
# En mode "real" uniquement :
# LDAP_HOST=ldap.dgfip.interne
# LDAP_PORT=636
# LDAP_USE_SSL=true
