# Copier ce fichier en ".env" à la racine du projet avant de lancer
# `docker compose up`. Ce fichier ne doit JAMAIS être commité une fois
# rempli (déjà exclu par .gitignore).

# ---------------------------------------------------------------------
# Secret partagé entre webapp, auth-system et log-collector pour
# authentifier les appels inter-services (réseau interne uniquement).
# Générer une valeur aléatoire, par ex. : openssl rand -hex 32
# ---------------------------------------------------------------------
INTERNAL_SHARED_SECRET=change-moi-avec-openssl-rand--hex-32

# ---------------------------------------------------------------------
# IMPORTANT : ne jamais mettre à "true" en production. Cette option
# renvoie le code 2FA dans la réponse JSON pour permettre de tester le
# parcours sans serveur de messagerie réel.
# ---------------------------------------------------------------------
DEBUG_EXPOSE_MFA_CODE=false

# Passer FLASK_DEBUG=true uniquement en développement local hors
# Docker (jamais avec gunicorn, qui l'ignore de toute façon).
FLASK_DEBUG=false

# ---------------------------------------------------------------------
# Annuaire LDAP — "mock" (par défaut, aucune dépendance externe) ou
# "real" pour brancher un vrai serveur LDAP d'entreprise.
# ---------------------------------------------------------------------
LDAP_MODE=mock
LDAP_BASE_DN=dc=dgfip,dc=local
LDAP_BIND_DN=cn=auth-system,dc=dgfip,dc=local
LDAP_BIND_PASSWORD=change-moi-en-production
# En LDAP_MODE=real uniquement :
# LDAP_HOST=ldap.dgfip.interne
# LDAP_PORT=636
# LDAP_USE_SSL=true

# ---------------------------------------------------------------------
# Port HTTP exposé sur l'hôte par le frontend (seul service publié).
# ---------------------------------------------------------------------
HTTP_PORT=80
