# Copier ce fichier en ".env" et adapter les valeurs avant de lancer l'API.
SECRET_KEY=change-moi-en-production
DATABASE_URL=sqlite:///dgfip_auth.db
FRONTEND_ORIGIN=http://localhost:5173

# En développement uniquement : renvoie le code MFA dans la réponse JSON
# pour permettre de tester le parcours sans serveur de messagerie.
# À retirer impérativement en production (le code doit UNIQUEMENT partir par e-mail).
DEBUG_EXPOSE_MFA_CODE=true
