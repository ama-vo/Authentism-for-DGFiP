# Généré automatiquement par `python scripts/init_env.py` (recommandé).
# Ne jamais commiter le fichier .env rempli (exclu par .gitignore).

APP_ENV=production

# Secret(s) d'authentification inter-services. Plusieurs valeurs séparées
# par des virgules sont acceptées : la PREMIÈRE sert à émettre, toutes
# sont acceptées en réception -> renouvellement sans interruption.
INTERNAL_SHARED_SECRETS=

# Clé HMAC de la chaîne d'intégrité des journaux (connue du seul collecteur).
LOG_SIGNING_KEY=

# Annuaire OpenLDAP (compte cn=admin,dc=dgfip,dc=fr) et configuration.
LDAP_ADMIN_PASSWORD=
LDAP_CONFIG_PASSWORD=

# Redis (sessions). Caractères hexadécimaux uniquement (utilisé dans une URL).
REDIS_PASSWORD=

# Comptes de démonstration créés au premier démarrage.
SEED_DEMO_ACCOUNTS=true
# JAMAIS true en production : renvoie le code 2FA dans la réponse HTTP.
DEBUG_EXPOSE_MFA_CODE=false

# Exposition
HTTP_PORT=80
HTTPS_PORT=443
MAILPIT_UI_PORT=8025
PUBLIC_HOSTNAMES=localhost
# Origines SUPPLÉMENTAIRES autorisées (la page servie par le site lui-même
# est toujours acceptée, quelle que soit l'adresse : localhost, 127.0.0.1...).
ALLOWED_ORIGINS=
