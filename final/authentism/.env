# =============================================================
#  Configuration Authentism - copier ce fichier en .env :
#     cp .env.example .env
#  Ne jamais publier le fichier .env !
# =============================================================

# --- Mots de passe internes (à changer) ---
REDIS_PASSWORD=ChangeMoi-Redis-2026
POSTGRES_PASSWORD=ChangeMoi-Postgres-2026

# =============================================================
#  MODE TEST (par défaut) : un LDAP de test est démarré automatiquement
#  avec 3 comptes (voir ldap/ldap-test.ldif). Rien d'autre à configurer.
# =============================================================
COMPOSE_PROFILES=test
LDAP_URL=ldap://ldap-test:389
LDAP_BIND_DN=cn=admin,dc=dgfip,dc=local
LDAP_BIND_PASSWORD=ChangeMoi-Ldap-2026
LDAP_USERS_DN=ou=users,dc=dgfip,dc=local
LDAP_ADMINS_DN=ou=admins,dc=dgfip,dc=local
LDAP_LOGIN_ATTRIBUTE=uid
LDAP_ROLE_ATTRIBUTE=employeeType

# =============================================================
#  MODE PRODUCTION : connexion au vrai annuaire de la DGFiP
#  1. supprimer la ligne COMPOSE_PROFILES=test
#  2. remplacer les valeurs LDAP ci-dessus, par exemple :
#       LDAP_URL=ldaps://ldap.dgfip.local:636        (ldaps = chiffré, obligatoire)
#       LDAP_URL=ldaps://host.docker.internal:636    (LDAP installé sur la machine hôte)
#       LDAP_BIND_DN=<compte de service de l'application>
#       LDAP_BIND_PASSWORD=<son mot de passe>
#       LDAP_USERS_DN=<branche contenant les comptes>
#       LDAP_ADMINS_DN=<branche contenant les comptes d'administration>
#  3. si le certificat du LDAP est signé par une CA interne : la copier dans ldap/ca.crt
# =============================================================
