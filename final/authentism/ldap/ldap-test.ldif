# =============================================================
#  LDAP DE TEST UNIQUEMENT (service "ldap-test" de docker-compose.yml)
#  Chargé automatiquement au premier démarrage du LDAP de test.
#
#  Comptes de connexion (ou=users) :
#    1000000000001  Admin#Dgfip2026!   (admin)
#    2000000000002  Agent#Dgfip2026!   (agent)
#    3000000000003  Usager#Dgfip2026!  (usager)
#
#  Compte d'administration (ou=admins) - mot de passe DIFFÉRENT,
#  demandé pour ouvrir le panneau d'administration :
#    1000000000001  AdminPanel#2026!
#
#  Les mots de passe sont stockés hachés ({SSHA}), jamais en clair.
# =============================================================

dn: ou=users,dc=dgfip,dc=local
objectClass: organizationalUnit
ou: users

dn: ou=admins,dc=dgfip,dc=local
objectClass: organizationalUnit
ou: admins

dn: uid=1000000000001,ou=users,dc=dgfip,dc=local
objectClass: inetOrgPerson
uid: 1000000000001
cn: Alice Martin
givenName: Alice
sn: Martin
mail: admin@dgfip.local
employeeType: admin
userPassword: {SSHA}mcs08L/TzXN5STLHsVK9+kBz4Rhn+yxjKT4bhg==

